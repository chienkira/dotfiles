[user]
  name = chien
  email = chienhedspi@gmail.com
[init]
  defaultBranch = main
[core]
  excludesfile = ~/.gitignore
[push]
  autoSetupRemote = true
  default = current
[pull]
  rebase = true
  ff = only
[rebase]
  autoStash = true
  autoSquash = true
[alias]
  st = status -sb
  lg = log --graph --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
