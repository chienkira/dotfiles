[user]
  name = chien
  email = chienhedspi@gmail.com
[init]
  defaultBranch = main
[core]
  excludesfile = ~/.gitignore
[push]
  autoSetupRemote = true
  default = current
[pull]
  rebase = true
  ff = only
[rebase]
  autoStash = true
  autoSquash = true
[alias]
  st = status -sb
  lg = log --oneline --graph --decorate --all
